@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root {
  --bg: #04070b;
  --bg-soft: #0d1420;
  --panel: #101c2d;
  --panel-strong: #17263a;
  --line: rgba(255, 255, 255, 0.08);
  --blue: #14335a;
  --blue-strong: #1d4d80;
  --blue-soft: #3a7bd5;
  --text: #edf5ff;
  --muted: #a4b4ca;
  --danger: #ff5a5a;
  --success: #6ce3a3;
  --shadow: 0 18px 40px rgba(3, 7, 18, 0.45);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: radial-gradient(circle at top, rgba(26, 62, 104, 0.5), transparent 28%), var(--bg);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}

#root {
  min-height: 100vh;
}

.page-shell {
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px 18px 60px;
}

.compact-shell {
  max-width: 700px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 32px;
  padding: 16px 18px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(13, 20, 32, 0.75);
  backdrop-filter: blur(10px);
  box-shadow: var(--shadow);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--blue-soft), var(--blue-strong));
  font-weight: 800;
  letter-spacing: 1px;
}

.brand-name {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: 0.14rem;
}

.brand-block small {
  color: var(--muted);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav-link,
.nav-btn {
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
  border-radius: 999px;
  padding: 10px 15px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
}

.nav-link.active,
.nav-link:hover,
.nav-btn:hover,
.primary-btn:hover,
.ghost-btn:hover,
.danger-btn:hover {
  transform: translateY(-1px);
}

.nav-link.active {
  background: linear-gradient(135deg, var(--blue-soft), var(--blue-strong));
  border-color: transparent;
}

.hero {
  display: grid;
  align-items: center;
  padding: 18px 0 24px;
}

.eyebrow {
  margin: 0 0 10px;
  color: var(--blue-soft);
  text-transform: uppercase;
  letter-spacing: 0.12rem;
  font-size: 0.76rem;
  font-weight: 700;
}

.hero h1 {
  margin: 0;
  max-width: 760px;
  font-size: clamp(2.5rem, 5vw, 4.6rem);
  line-height: 0.95;
  letter-spacing: -0.08rem;
}

.hero-copy {
  max-width: 650px;
  color: var(--muted);
  line-height: 1.7;
  margin-top: 18px;
  font-size: 1.05rem;
}

.catalog {
  margin-top: 30px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.product-card {
  background: linear-gradient(180deg, rgba(17, 26, 38, 1), rgba(12, 20, 31, 1));
  border: 1px solid var(--line);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.image-wrap {
  position: relative;
  height: 220px;
  overflow: hidden;
  background: #0a1220;
}

.image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-body {
  padding: 18px;
}

.card-body h3 {
  margin: 0 0 10px;
  font-size: 1.13rem;
}

.card-body p {
  margin: 0 0 18px;
  color: var(--muted);
  line-height: 1.6;
  min-height: 72px;
}

.card-body a,
.primary-btn,
.ghost-btn,
.danger-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 12px;
  padding: 11px 18px;
  font-weight: 700;
  transition: 0.2s ease;
}

.card-body a,
.primary-btn {
  background: linear-gradient(135deg, var(--blue-soft), var(--blue-strong));
  color: var(--text);
}

.loader,
.notice {
  display: inline-flex;
  margin-bottom: 18px;
  border-radius: 12px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  background: rgba(18, 27, 39, 0.8);
}

.notice.error {
  border-color: rgba(255, 90, 90, 0.35);
  color: #ffd4d4;
}

.admin-login {
  display: flex;
  justify-content: center;
  padding-top: 20px;
}

.panel-box {
  background: rgba(15, 22, 31, 0.9);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: var(--shadow);
  padding: 24px;
}

.admin-login .panel-box {
  width: min(100%, 520px);
}

.panel-box h2 {
  margin: 0 0 18px;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
}

.product-form,
.admin-panel {
  display: grid;
  gap: 18px;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

label {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-weight: 600;
}

input,
textarea {
  width: 100%;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 12px 14px;
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
  outline: none;
}

input:focus,
textarea:focus {
  border-color: rgba(58, 123, 213, 0.8);
  box-shadow: 0 0 0 3px rgba(58, 123, 213, 0.1);
}

textarea {
  resize: vertical;
}

.form-actions,
.admin-item-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.full-width {
  width: 100%;
}

.ghost-btn {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--line);
}

.danger-btn {
  background: rgba(255, 90, 90, 0.12);
  color: #ffd3d3;
  border: 1px solid rgba(255, 90, 90, 0.25);
}

.error-text {
  display: block;
  margin-top: 8px;
  color: #ffb5b5;
}

.admin-panel {
  grid-template-columns: 1.2fr 1fr;
  margin-top: 18px;
}

.panel-header {
  margin-bottom: 18px;
}

.admin-list {
  min-height: 100%;
}

.admin-item {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
  border-top: 1px solid var(--line);
}

.admin-item:first-of-type {
  border-top: none;
  padding-top: 0;
}

.admin-item-info {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.admin-item-info img {
  width: 72px;
  height: 72px;
  object-fit: cover;
  border-radius: 12px;
}

.admin-item-info strong {
  display: block;
  margin-bottom: 6px;
}

.admin-item-info span {
  display: block;
  color: var(--muted);
  line-height: 1.5;
  max-width: 260px;
}

@media (max-width: 900px) {
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-panel {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .page-shell {
    padding-left: 14px;
    padding-right: 14px;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-actions {
    width: 100%;
    justify-content: space-between;
  }

  .product-grid,
  .field-grid {
    grid-template-columns: 1fr;
  }

  .admin-item {
    flex-direction: column;
  }
}
